# Copy to .env.local and fill in. Never commit .env.local.

# Public origin of the site, no trailing slash. Production: https://jubileecv.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase dashboard > Project Settings > API (wired up by spec 01, decision 0004)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Google and LinkedIn sign-in (decision 0006): on the hosted project the client IDs
# and secrets go in Supabase (Authentication > Providers), not in the app.
# Only the local Supabase CLI stack (supabase/config.toml) reads these. Never NEXT_PUBLIC_.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# SUPABASE_AUTH_EXTERNAL_LINKEDIN_OIDC_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_LINKEDIN_OIDC_SECRET=

# Google Search Console HTML-tag verification (optional; DNS verification needs nothing here)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_token
